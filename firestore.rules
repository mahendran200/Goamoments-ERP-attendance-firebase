rules_version = '2';

// All reads/writes go through the Next.js server using the Firebase Admin
// SDK (see db/index.ts), which bypasses these rules entirely. Client-side
// SDK access is intentionally denied here — the browser never talks to
// Firestore directly in this app.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
